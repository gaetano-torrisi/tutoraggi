rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/authorizedEmails/$(userEmail()));
    }

    function userListed() {
      return signedIn() &&
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/authorizedEmails/$(userEmail()));
    }

    function role() {
      return userListed() ? userDoc().data.role : null;
    }

    function isViewer() {
      return role() == 'viewer';
    }

    function isUser() {
      return role() == 'user';
    }

    function isAdmin() {
      return role() == 'admin' || role() == 'superadmin';
    }

    function isSuperAdmin() {
      return role() == 'superadmin';
    }

    // Un admin può gestire SOLO utenti non-admin (viewer/user):
    // - il ruolo ESISTENTE del target dev'essere viewer/user (non tocca admin/superadmin)
    // - il NUOVO ruolo dev'essere viewer/user (non promuove ad admin/superadmin)
    function targetIsNonAdmin() {
      return resource.data.role == 'viewer' || resource.data.role == 'user';
    }
    function newRoleNonAdmin() {
      return request.resource.data.role == 'viewer' || request.resource.data.role == 'user';
    }

    function canReadAppData() {
      return signedIn() && userListed();
    }

    function canEditAppData() {
      return isUser() || isAdmin();
    }

    function canReadLogAndBackup() {
      return isUser() || isAdmin();
    }

    match /authorizedEmails/{email} {
      // S3-b: niente più lettura pubblica dei ruoli.
      // Ognuno legge solo il proprio documento; gli admin leggono tutti.
      allow get: if isAdmin() || (signedIn() && email == userEmail());
      allow list: if isAdmin();
      // S3-a: il superadmin può tutto. L'admin:
      //  • gestisce solo utenti viewer/user, mantenendoli viewer/user;
      //  • può auto-declassarsi a viewer/user (modifica del proprio doc solo verso il basso);
      //  • non può promuoversi a superadmin né toccare in alcun modo altri admin/superadmin.
      // create: nuovo utente → admin solo con ruolo viewer/user.
      allow create: if isSuperAdmin()
        || (isAdmin() && newRoleNonAdmin());
      // update: admin su sé stesso solo per declassarsi (viewer/user);
      //         su altri solo se target è viewer/user e resta viewer/user.
      allow update: if isSuperAdmin()
        || (isAdmin() && email == userEmail() && newRoleNonAdmin())
        || (isAdmin() && email != userEmail() && targetIsNonAdmin() && newRoleNonAdmin());
      // delete: admin solo target viewer/user, mai se stesso né altri admin.
      allow delete: if isSuperAdmin()
        || (isAdmin() && email != userEmail() && targetIsNonAdmin());
    }

    // ── Corsi (ex avvisi): sessioni in calendario ──
    match /corsi/{doc} {
      allow read: if canReadAppData();
      allow write: if canEditAppData();
    }

    // ── Anagrafica corsi (ex anagraficaAv) ──
    match /anagraficaCorsi/{doc} {
      allow read: if canReadAppData();
      allow write: if canEditAppData();
    }

    // ── Avvisi / Progetti (entità padre) ──
    match /avvisi_progetti/{doc} {
      allow read: if canReadAppData();
      allow write: if canEditAppData();
    }

    // ── Legacy (vecchie collection, mantenute per sicurezza) ──
    match /avvisi/{doc} {
      allow read: if canReadAppData();
      allow write: if canEditAppData();
    }

    match /anagraficaAv/{doc} {
      allow read: if canReadAppData();
      allow write: if canEditAppData();
    }

    match /tutors/{doc} {
      allow read: if canReadAppData();
      allow write: if canEditAppData();
    }

    match /tutEvents/{doc} {
      allow read: if canReadAppData();
      allow write: if canEditAppData();
    }

    // ── Profili utente (dati anagrafici personali, doc per UID) ──
    // L'esistenza del doc è anche il marcatore "ha già effettuato l'accesso"
    // mostrato in Gestione utenti. Ognuno gestisce SOLO il proprio profilo;
    // gli admin/superadmin leggono e modificano tutti (pannello utenti, import/backup).
    match /userProfiles/{uid} {
      allow get: if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // NOTA [S2]: settings/app è leggibile da tutti gli utenti autorizzati
    // (serve per tema/logo/colori) ma contiene anche le chiavi API in chiaro,
    // quindi resta leggibile da chiunque sia autorizzato. Per proteggerle
    // davvero vanno spostate in un documento separato (es. settings/secrets
    // leggibile solo dal superadmin) oppure dietro un backend proxy.
    match /settings/{doc} {
      allow read: if canReadAppData();
      allow write: if isSuperAdmin();
    }

    match /activityLog/{doc} {
      allow create: if signedIn() && userListed();
      allow read: if canReadLogAndBackup();
      allow update, delete: if false;
    }

    // I backup sono dump completi del DB: solo admin/superadmin.
    match /backups/{doc} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
